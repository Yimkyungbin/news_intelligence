{
  "name": "linkedin_intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"tests/unit/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "test:db": "docker exec -i supabase_db_linkedin_intelligence psql -U postgres -q -v ON_ERROR_STOP=1 < supabase/tests/rls_test.sql",
    "test:e2e": "uv run --quiet --with playwright==1.55.0 python scripts/e2e_smoke.py",
    "verify:full": "bash scripts/verify-full.sh"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.12.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "simple-icons": "16.37.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
