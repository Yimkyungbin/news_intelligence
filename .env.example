# ===== Supabase (필수) =====
# Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 브라우저 노출 가능 (RLS로 보호). 레거시 키 사용 시 NEXT_PUBLIC_SUPABASE_ANON_KEY 도 지원
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 서버 전용 비밀키 - 절대 NEXT_PUBLIC_ 접두사 금지. 계정 삭제 기능에 사용
# 레거시 키 사용 시 SUPABASE_SERVICE_ROLE_KEY 도 지원
SUPABASE_SECRET_KEY=

# 인증 메일 리다이렉트 기준 URL (Vercel 에서는 자동 감지되므로 커스텀 도메인일 때만 설정)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Phase 2 수집 =====
# Vercel Cron 인증용 (openssl rand -hex 32). Vercel 이 Authorization: Bearer <값> 으로 호출
CRON_SECRET=
# 선택: GitHub 검색 API 한도 상향용 (권한 없는 fine-grained 토큰이면 충분)
GITHUB_TOKEN=
# 선택: OpenAlex 무료 키 (https://openalex.org/settings/api). 없으면 IP 공용 하루 무료 한도로 동작
OPENALEX_API_KEY=

# ===== Phase 3 AI =====
# 실제 키는 이 파일이 아니라 .env.local(로컬) 또는 Vercel 환경변수(Sensitive)에 넣으세요. 이 파일은 공개 저장소에 올라갑니다.
OPENAI_API_KEY=
# 선택: openai | mock. 비우면 키가 있으면 openai, 없으면 로컬·Preview 는 mock(DEMO), 운영은 비활성
AI_PROVIDER=
# 운영자 이메일 (쉼표 구분, "@도메인" 가능). 출처별 AI 번역·요약 허용을 바꿀 수 있음
ADMIN_EMAILS=
