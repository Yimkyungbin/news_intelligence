# ===== Supabase (필수) =====
# Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 브라우저 노출 가능 (RLS로 보호). 레거시 키 사용 시 NEXT_PUBLIC_SUPABASE_ANON_KEY 도 지원
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 서버 전용 비밀키 - 절대 NEXT_PUBLIC_ 접두사 금지. 계정 삭제 기능에 사용
# 레거시 키 사용 시 SUPABASE_SERVICE_ROLE_KEY 도 지원
SUPABASE_SECRET_KEY=

# 인증 메일 리다이렉트 기준 URL (Vercel 에서는 자동 감지되므로 커스텀 도메인일 때만 설정)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Phase 2 수집 =====
# Vercel Cron 인증용 (openssl rand -hex 32). Vercel 이 Authorization: Bearer <값> 으로 호출
CRON_SECRET=
# 선택: GitHub 검색 API 한도 상향용 (권한 없는 fine-grained 토큰이면 충분)
GITHUB_TOKEN=

# ===== Phase 3 (선택) =====
OPENAI_API_KEY=
